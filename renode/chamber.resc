:name: Fab Chamber Controller
:description: Runs the chamber controller firmware on a virtual STM32F4 Discovery board

using sysbus
mach create "chamber_ctrl"
machine LoadPlatformDescription @platforms/boards/stm32f4_discovery-kit.repl

# Step 5: two virtual switches wired to the controller's safety inputs
machine LoadPlatformDescriptionFromString "estop: Miscellaneous.Button @ gpioPortC 0 { -> gpioPortC@0 }"
machine LoadPlatformDescriptionFromString "door: Miscellaneous.Button @ gpioPortC 1 { -> gpioPortC@1 }"

showAnalyzer sysbus.usart2

$bin?=@C:/embedded/fab-chamber-controller/firmware/chamber_ctrl/Debug/chamber_ctrl.elf

macro reset
"""
    sysbus LoadELF $bin
"""
runMacro $reset

start
